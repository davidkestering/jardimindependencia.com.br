POSTGRES_USER=condominio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=condominio
SECRET_KEY=troque-esta-chave
# primeiro administrador (criado só se não existir)
ADMIN_LOGIN=admin
ADMIN_SENHA_INICIAL=troque-esta-senha
# SMTP do Mailu (465 = SSL implícito; 587 usa STARTTLS)
SMTP_HOST=mail.jardimindependencia.com.br
SMTP_PORT=465
SMTP_USER=contato@jardimindependencia.com.br
SMTP_PASS=senha-da-caixa-contato
MAIL_CONTATO=contato@jardimindependencia.com.br
SITE_URL=https://jardimindependencia.com.br
SMTP_NOREPLY_USER=no-reply@jardimindependencia.com.br
SMTP_NOREPLY_PASS=
# APNs (push do app iOS): chave .p8 gerada no Apple Developer, copiada para data/apns/AuthKey.p8 (fora do git). Vazio = desligado.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=br.com.jardimindependencia.app
APNS_KEY_PATH=/data/apns/AuthKey.p8
